,8,0,0,1,168,168Z"></path></svg><div><h3 class="text-sm font-semibold">Respostas rápidas</h3><p class="mt-1 text-xs text-muted-foreground">Scripts salvos para responder mais rápido, seus ou da equipe.</p></div></div></a><a class="block" href="/app/automacoes"><div data-slot="card" class="rounded-lg border border-border bg-surface text-text shadow-xs flex h-full gap-3 p-4 transition-colors hover:border-border-strong"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true" class="mt-0.5 shrink-0 text-muted-foreground"><path d="M245.66,74.34l-32-32a8,8,0,0,0-11.32,11.32L220.69,72H208c-49.33,0-61.05,28.12-71.38,52.92-9.38,22.51-16.92,40.59-49.48,42.84a40,40,0,1,0,.1,16c43.26-2.65,54.34-29.15,64.14-52.69C161.41,107,169.33,88,208,88h12.69l-18.35,18.34a8,8,0,0,0,11.32,11.32l32-32A8,8,0,0,0,245.66,74.34ZM48,200a24,24,0,1,1,24-24A24,24,0,0,1,48,200Z"></path></svg><div><h3 class="text-sm font-semibold">Automações</h3><p class="mt-1 text-xs text-muted-foreground">Regras que mexem no CRM sozinhas: criar negócio, pôr tag, preencher campo, definir responsável.</p></div></div></a><a class="block" href="/app/tasks"><div data-slot="card" class="rounded-lg border border-border bg-surface text-text shadow-xs flex h-full gap-3 p-4 transition-colors hover:border-border-strong"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true" class="mt-0.5 shrink-0 text-muted-foreground"><path d="M224,128a8,8,0,0,1-8,8H128a8,8,0,0,1,0-16h88A8,8,0,0,1,224,128ZM128,72h88a8,8,0,0,0,0-16H128a8,8,0,0,0,0,16Zm88,112H128a8,8,0,0,0,0,16h88a8,8,0,0,0,0-16ZM82.34,42.34,56,68.69,45.66,58.34A8,8,0,0,0,34.34,69.66l16,16a8,8,0,0,0,11.32,0l32-32A8,8,0,0,0,82.34,42.34Zm0,64L56,132.69,45.66,122.34a8,8,0,0,0-11.32,11.32l16,16a8,8,0,0,0,11.32,0l32-32a8,8,0,0,0-11.32-11.32Zm0,64L56,196.69,45.66,186.34a8,8,0,0,0-11.32,11.32l16,16a8,8,0,0,0,11.32,0l32-32a8,8,0,0,0-11.32-11.32Z"></path></svg><div><h3 class="text-sm font-semibold">Tarefas</h3><p class="mt-1 text-xs text-muted-foreground">O que ficou combinado, com prazo — e o que já venceu sem ninguém fazer.</p></div></div></a><a class="block" href="/app/products"><div data-slot="card" class="rounded-lg border border-border bg-surface text-text shadow-xs flex h-full gap-3 p-4 transition-colors hover:border-border-strong"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true" class="mt-0.5 shrink-0 text-muted-foreground"><path d="M232,96a7.89,7.89,0,0,0-.3-2.2L217.35,43.6A16.07,16.07,0,0,0,202,32H54A16.07,16.07,0,0,0,38.65,43.6L24.31,93.8A7.89,7.89,0,0,0,24,96h0v16a40,40,0,0,0,16,32v72a8,8,0,0,0,8,8H208a8,8,0,0,0,8-8V144a40,40,0,0,0,16-32V96ZM54,48H202l11.42,40H42.61Zm50,56h48v8a24,24,0,0,1-48,0Zm-16,0v8a24,24,0,0,1-35.12,21.26,7.88,7.88,0,0,0-1.82-1.06A24,24,0,0,1,40,112v-8ZM200,208H56V151.2a40.57,40.57,0,0,0,8,.8,40,40,0,0,0,32-16,40,40,0,0,0,64,0,40,40,0,0,0,32,16,40.57,40.57,0,0,0,8-.8Zm4.93-75.8a8.08,8.08,0,0,0-1.8,1.05A24,24,0,0,1,168,112v-8h48v8A24,24,0,0,1,204.93,132.2Z"></path></svg><div><h3 class="text-sm font-semibold">Produtos</h3><p class="mt-1 text-xs text-muted-foreground">O catálogo da loja, com o preço que o atendente de IA responde.</p></div></div></a><a class="block" href="/app/settings/tenant/agenda"><div data-slot="card" class="rounded-lg border border-border bg-surface text-text shadow-xs flex h-full gap-3 p-4 transition-colors hover:border-border-strong"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true" class="mt-0.5 shrink-0 text-muted-foreground"><path d="M208,32H184V24a8,8,0,0,0-16,0v8H88V24a8,8,0,0,0-16,0v8H48A16,16,0,0,0,32,48V208a16,16,0,0,0,16,16H208a16,16,0,0,0,16-16V48A16,16,0,0,0,208,32ZM72,48v8a8,8,0,0,0,16,0V48h80v8a8,8,0,0,0,16,0V48h24V80H48V48ZM208,208H48V96H208V208Z"></path></svg><div><h3 class="text-sm font-semibold">Tipos de agendamento</h3><p class="mt-1 text-xs text-muted-foreground">O que se pode marcar, quanto dura, onde acontece e quem atende.</p></div></div></a></div></section><section aria-labelledby="hub-organizacao-ia" class="space-y-3"><h2 id="hub-organizacao-ia" class="text-xs font-medium tracking-wider text-muted-foreground uppercase">IA</h2><div class="grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-3"><a class="block" href="/app/ai/followups"><div data-slot="card" class="rounded-lg border border-border bg-surface text-text shadow-xs flex h-full gap-3 p-4 transition-colors hover:border-border-strong"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true" class="mt-0.5 shrink-0 text-muted-foreground"><path d="M245.66,74.34l-32-32a8,8,0,0,0-11.32,11.32L220.69,72H208c-49.33,0-61.05,28.12-71.38,52.92-9.38,22.51-16.92,40.59-49.48,42.84a40,40,0,1,0,.1,16c43.26-2.65,54.34-29.15,64.14-52.69C161.41,107,169.33,88,208,88h12.69l-18.35,18.34a8,8,0,0,0,11.32,11.32l32-32A8,8,0,0,0,245.66,74.34ZM48,200a24,24,0,1,1,24-24A24,24,0,0,1,48,200Z"></path></svg><div><h3 class="text-sm font-semibold">Follow-ups</h3><p class="mt-1 text-xs text-muted-foreground">Como o agente retoma uma conversa que esfriou, para nenhuma morrer no silêncio.</p></div></div></a><a class="block" href="/app/ai/routers"><div data-slot="card" class="rounded-lg border border-border bg-surface text-text shadow-xs flex h-full gap-3 p-4 transition-colors hover:border-border-strong"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true" class="mt-0.5 shrink-0 text-muted-foreground"><path d="M246,106.65,212.33,69.3A16,16,0,0,0,200.44,64H136V32a8,8,0,0,0-16,0V64H40A16,16,0,0,0,24,80v64a16,16,0,0,0,16,16h80v64a8,8,0,0,0,16,0V160h64.44a16,16,0,0,0,11.89-5.3L246,117.35A8,8,0,0,0,246,106.65ZM200.44,144H40V80H200.44l28.8,32Z"></path></svg><div><h3 class="text-sm font-semibold">Roteadores</h3><p class="mt-1 text-xs text-muted-foreground">Qual agente pega qual conversa, e quando o humano assume.</p></div></div></a><a class="block" href="/app/ai/credentials"><div data-slot="card" class="rounded-lg border border-border bg-surface text-text shadow-xs flex h-full gap-3 p-4 transition-colors hover:border-border-strong"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true" class="mt-0.5 shrink-0 text-muted-foreground"><path d="M216.57,39.43A80,80,0,0,0,83.91,120.78L28.69,176A15.86,15.86,0,0,0,24,187.31V216a16,16,0,0,0,16,16H72a8,8,0,0,0,8-8V208H96a8,8,0,0,0,8-8V184h16a8,8,0,0,0,5.66-2.34l9.56-9.57A79.73,79.73,0,0,0,160,176h.1A80,80,0,0,0,216.57,39.43ZM224,98.1c-1.09,34.09-29.75,61.86-63.89,61.9H160a63.7,63.7,0,0,1-23.65-4.51,8,8,0,0,0-8.84,1.68L116.69,168H96a8,8,0,0,0-8,8v16H72a8,8,0,0,0-8,8v16H40V187.31l58.83-58.82a8,8,0,0,0,1.68-8.84A63.72,63.72,0,0,1,96,95.92c0-34.14,27.81-62.8,61.9-63.89A64,64,0,0,1,224,98.1ZM192,76a12,12,0,1,1-12-12A12,12,0,0,1,192,76Z"></path></svg><div><h3 class="text-sm font-semibold">Usar minha própria chave de IA (avançado)</h3><p class="mt-1 text-xs text-muted-foreground">Para quem quer usar outro modelo (Grok, Claude, Gemini…) com a própria conta do OpenRouter. O consumo nessa chave não desconta dos tokens do plano.</p></div></div></a><a class="block" href="/app/ai/jev"><div data-slot="card" class="rounded-lg border border-border bg-surface text-text shadow-xs flex h-full gap-3 p-4 transition-colors hover:border-border-strong"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true" class="mt-0.5 shrink-0 text-muted-foreground"><path d="M176,232a8,8,0,0,1-8,8H88a8,8,0,0,1,0-16h80A8,8,0,0,1,176,232Zm40-128a87.55,87.55,0,0,1-33.64,69.21A16.24,16.24,0,0,0,176,186v6a16,16,0,0,1-16,16H96a16,16,0,0,1-16-16v-6a16,16,0,0,0-6.23-12.66A87.59,87.59,0,0,1,40,104.49C39.74,56.83,78.26,17.14,125.88,16A88,88,0,0,1,216,104Zm-16,0a72,72,0,0,0-73.74-72c-39,.92-70.47,33.39-70.26,72.39a71.65,71.65,0,0,0,27.64,56.3A32,32,0,0,1,96,186v6h64v-6a32.15,32.15,0,0,1,12.47-25.35A71.65,71.65,0,0,0,200,104Zm-16.11-9.34a57.6,57.6,0,0,0-46.56-46.55,8,8,0,0,0-2.66,15.78c16.57,2.79,30.63,16.85,33.44,33.45A8,8,0,0,0,176,104a9,9,0,0,0,1.35-.11A8,8,0,0,0,183.89,94.66Z"></path></svg><div><h3 class="text-sm font-semibold">Decisões rápidas (Jev)</h3><p class="mt-1 text-xs text-muted-foreground">Classificações rápidas de mensagens com o Jev, da TypeSafe. Precisa ser ligado e aceito por um administrador.</p></div></div></a></div></section><section aria-labelledby="hub-organizacao-canais" class="space-y-3"><h2 id="hub-organizacao-canais" class="text-xs font-medium tracking-wider text-muted-foreground uppercase">Canais</h2><div class="grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-3"><a class="block" href="/app/connections"><div data-slot="card" class="rounded-lg border border-border bg-surface text-text shadow-xs flex h-full gap-3 p-4 transition-colors hover:border-border-strong"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true" class="mt-0.5 shrink-0 text-muted-foreground"><path d="M237.66,18.34a8,8,0,0,0-11.32,0l-52.4,52.41-5.37-5.38a32.05,32.05,0,0,0-45.26,0L100,88.69l-6.34-6.35A8,8,0,0,0,82.34,93.66L88.69,100,65.37,123.31a32,32,0,0,0,0,45.26l5.38,5.37-52.41,52.4a8,8,0,0,0,11.32,11.32l52.4-52.41,5.37,5.38a32,32,0,0,0,45.26,0L156,167.31l6.34,6.35a8,8,0,0,0,11.32-11.32L167.31,156l23.32-23.31a32,32,0,0,0,0-45.26l-5.38-5.37,52.41-52.4A8,8,0,0,0,237.66,18.34Zm-116.29,161a16,16,0,0,1-22.62,0L76.69,157.25a16,16,0,0,1,0-22.62L100,111.31,144.69,156Zm57.94-57.94L156,144.69,111.31,100l23.32-23.31a16,16,0,0,1,22.62,0l22.06,22A16,16,0,0,1,179.31,121.37ZM88.57,35A8,8,0,0,1,103.43,29l8,20A8,8,0,0,1,96.57,55ZM24.57,93A8,8,0,0,1,35,88.57l20,8A8,8,0,0,1,49,111.43l-20-8A8,8,0,0,1,24.57,93ZM231.43,163a8,8,0,0,1-10.4,4.46l-20-8A8,8,0,1,1,207,144.57l20,8A8,8,0,0,1,231.43,163Zm-64,58.06A8,8,0,0,1,152.57,227l-8-20A8,8,0,0,1,159.43,201Z"></path></svg><div><h3 class="text-sm font-semibold">Conexões</h3><p class="mt-1 text-xs text-muted-foreground">Seus números de WhatsApp: por QR ou canal oficial da Meta, com saúde, reconexão e templates.</p></div></div></a><a class="block" href="/app/webhooks"><div data-slot="card" class="rounded-lg border border-border bg-surface text-text shadow-xs flex h-full gap-3 p-4 transition-colors hover:border-border-strong"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 256 256" aria-hidden="true" class="mt-0.5 shrink-0 text-muted-foreground"><path d="M178.16,176H111.32A48,48,0,1,1,25.6,139.19a8,8,0,0,1,12.8,9.61A31.69,31.69,0,0,0,32,168a32,32,0,0,0,64,0,8,8,0,0,1,8-8h74.16a16,16,0,1,1,0,16ZM64,184a16,16,0,0,0,14.08-23.61l35.77-58.14a8,8,0,0,0-2.62-11,32,32,0,1,1,46.1-40.06A8,8,0,1,0,172,44.79a48,48,0,1,0-75.62,55.33L64.44,152c-.15,0-.29,0-.44,0a16,16,0,0,0,0,32Zm128-64a48.18,48.18,0,0,0-18,3.49L142.08,71.6A16,16,0,1,0,128,80l.44,0,35.78,58.15a8,8,0,0,0,11,2.61A32,32,0,1,1,192,200a8,8,0,0,0,0,16,48,48,0,0,0,0-96Z"></path></svg><div><h3 class="text-sm font-semibold">Webhooks e regras antigas</h3><p class="mt-1 text-xs text-muted-foreground">Regras que agem sozinhas, entrada de leads de sites e formulários, e o registro do que chegou e do que rodou.</p></div></div></a></div></section></div>"`;
